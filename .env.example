# Telegram bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Public domain for nginx / Certbot (no scheme), e.g. bets.example.com
DOMAIN=your-domain.com

# Public HTTPS URL of the WebApp (Telegram requires HTTPS outside localhost).
# Local smoke: http://127.0.0.1:8000/webapp/  (run_api.py auto-bumps port if
# Laragon/php already owns 8000 — match the port printed at startup).
# Production example: https://your-domain.com/webapp/
WEBAPP_URL=http://127.0.0.1:8000/webapp/

# Deployment mode. prod (default in docker-compose) → the API REFUSES TO START
# when TELEGRAM_AUTH_DISABLED=true, hides /docs and restricts CORS to DOMAIN.
# Use APP_ENV=dev only for a local, non-public stack.
APP_ENV=prod
# Expose Swagger /docs + /openapi.json in prod (default off in prod).
# ENABLE_DOCS=false

# Optional: comma-separated CORS origins.
# Default: * when not prod; https://$DOMAIN in prod. WebApp is same-origin.
# CORS_ORIGINS=https://your-domain.com

# Telegram Mini App API auth (src/api/auth.py) — keep false.
# Local dev only (never on a public host): run
#   APP_ENV=dev TELEGRAM_AUTH_DISABLED=true python run_api.py
TELEGRAM_AUTH_DISABLED=false
# TELEGRAM_AUTH_MAX_AGE=86400

# Telegram user ids (comma-separated) allowed to call write endpoints:
#   POST /api/v2/bets/place, POST /api/v1/teams/import-url
# Empty → nobody (fail closed) while auth is enabled.
ADMIN_TELEGRAM_IDS=
# React dashboard (/dashboard) outside Telegram: read-only bearer tokens,
# comma-separated, each >= 16 chars (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`).
# Sent as `Authorization: Bearer <token>`; never grants admin/write access.
# Empty → dashboard only works inside Telegram (initData).
DASHBOARD_API_TOKENS=
# Persisted paper bets must use as_of_time within this many seconds of now.
# PLACE_AS_OF_MAX_SKEW_SECONDS=300

# --- Odds freshness ---
# upcoming_fixtures cache older than this is stale: API refreshes over the
# network, falls back with stale=true, and value alerts are NOT sent.
FIXTURES_MAX_AGE_MINUTES=60
# fixtures_worker refresh cadence / leagues (keep interval < max age).
FIXTURES_REFRESH_INTERVAL_MINUTES=20
FIXTURES_REFRESH_LEAGUES=EPL,UWCL
# FIXTURES_REFRESH_BACKOFF_SECONDS=300
# MODEL_COLD_FIT_TTL_MINUTES=720
# Telegram send throttle (messages/second, Telegram limit ~30)
# TELEGRAM_SEND_RATE=25

# nginx: 1 → redirect HTTP to HTTPS (after Certbot + ssl.conf.template)
NGINX_FORCE_HTTPS=0

# --- Scheduler split (Dockerization V2) ---
# web_api runs uvicorn --workers 2 → compose forces ENABLE_*_SCHEDULER=false there.
# Value alerts  → telegram_bot service (ENABLE_VALUE_SCHEDULER=true)
# Settlement    → settlement_worker (python -m src.workers.settlement_worker)
# Data monitor  → data_monitor_worker (every DATA_MONITOR_INTERVAL_MINUTES)
#
# Local single-process (run_api.py only) — optional:
#   ENABLE_VALUE_SCHEDULER=true
#   ENABLE_SETTLE_SCHEDULER=true
# Do NOT enable the same jobs on both run_api.py and workers/bot.
ENABLE_VALUE_SCHEDULER=false
ENABLE_SETTLE_SCHEDULER=false

# Value alert thresholds (telegram_bot compose defaults: EV≥5, data_score≥75)
SIGNAL_MIN_EV=5
SIGNAL_MIN_DATA_SCORE=75
SIGNAL_MIN_LINE_DELTA=0.5
# SIGNAL_INTERVAL_MINUTES=20
# SIGNAL_HORIZON_HOURS=24

# Worker intervals
# DATA_MONITOR_INTERVAL_MINUTES=15
# DATA_MONITOR_FRESHNESS_MAX_AGE_HOURS=6
# DATA_MONITOR_PIT_LOOKBACK_HOURS=48
SETTLE_INTERVAL_MINUTES=30
