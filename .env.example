# Telegram bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Public domain for nginx / Certbot (no scheme), e.g. bets.example.com
DOMAIN=your-domain.com

# Public HTTPS URL of the WebApp (Telegram requires HTTPS outside localhost).
# Local smoke: http://127.0.0.1:8000/webapp/  (run_api.py auto-bumps port if
# Laragon/php already owns 8000 — match the port printed at startup).
# Production example: https://your-domain.com/webapp/
WEBAPP_URL=http://127.0.0.1:8000/webapp/

# Optional: comma-separated CORS origins (default *)
# CORS_ORIGINS=http://127.0.0.1:8000,https://your-domain.com

# Telegram Mini App API auth (src/api/auth.py).
# Local / pytest: true. Production Docker: false (require initData on /api/v1/*).
TELEGRAM_AUTH_DISABLED=true
# TELEGRAM_AUTH_MAX_AGE=86400

# --- Scheduler split (Dockerization V2) ---
# web_api runs uvicorn --workers 2 → compose forces ENABLE_*_SCHEDULER=false there.
# Value alerts  → telegram_bot service (ENABLE_VALUE_SCHEDULER=true)
# Settlement    → settlement_worker (python -m src.workers.settlement_worker)
# Data monitor  → data_monitor_worker (every DATA_MONITOR_INTERVAL_MINUTES)
#
# Local single-process (run_api.py only) — optional:
#   ENABLE_VALUE_SCHEDULER=true
#   ENABLE_SETTLE_SCHEDULER=true
# Do NOT enable the same jobs on both run_api.py and workers/bot.
ENABLE_VALUE_SCHEDULER=false
ENABLE_SETTLE_SCHEDULER=false

# Value alert thresholds (telegram_bot compose defaults: EV≥5, data_score≥75)
SIGNAL_MIN_EV=5
SIGNAL_MIN_DATA_SCORE=75
SIGNAL_MIN_LINE_DELTA=0.5
# SIGNAL_INTERVAL_MINUTES=20
# SIGNAL_HORIZON_HOURS=24

# Worker intervals
# DATA_MONITOR_INTERVAL_MINUTES=15
# DATA_MONITOR_FRESHNESS_MAX_AGE_HOURS=6
# DATA_MONITOR_PIT_LOOKBACK_HOURS=48
SETTLE_INTERVAL_MINUTES=30
