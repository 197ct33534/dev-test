# HTTP reverse proxy + ACME challenge (Certbot-ready).
# DOMAIN / NGINX_FORCE_HTTPS are substituted by the nginx image entrypoint.
#
# After certificates exist under /etc/letsencrypt/live/${DOMAIN}/:
#   cp ssl.conf.template.example → ssl.conf.template, set NGINX_FORCE_HTTPS=1
#   in .env, then `docker compose up -d nginx`. Port 80 then 301-redirects to
#   HTTPS (ACME challenges stay on HTTP). See DEPLOY.md.

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Security headers. Telegram Mini Apps are framed by web.telegram.org, so
    # no X-Frame-Options DENY/SAMEORIGIN — restrict framing via CSP instead.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        if ($force_https = "1") {
            return 301 https://$host$request_uri;
        }
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://web_api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        client_max_body_size 1m;
    }

    location / {
        if ($force_https = "1") {
            return 301 https://$host$request_uri;
        }
        proxy_pass http://web_api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        client_max_body_size 10m;
    }
}
