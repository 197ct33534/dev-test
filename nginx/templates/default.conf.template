# HTTP reverse proxy + ACME challenge (Certbot-ready).
# DOMAIN is substituted by the nginx image entrypoint (envsubst).
#
# After certificates exist under /etc/letsencrypt/live/${DOMAIN}/,
# switch to HTTPS: rename/copy ssl.conf.template.example → ssl.conf.template
# (and optionally tighten this file to redirect HTTP→HTTPS). See DEPLOY.md.

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://web_api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        client_max_body_size 10m;
    }
}
